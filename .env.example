# Environment
# Server-side only — used by `next start`, Docker, and the match API Worker.
# Never set NEXT_PUBLIC_TYPESAFE_API_KEY (that would leak the key in the browser).
TYPESAFE_API_KEY=

# GitHub Pages / split deploy (set by Actions, not required locally)
# NEXT_PUBLIC_BASE_PATH=/cv-by-jev
# NEXT_PUBLIC_MATCH_API_BASE=https://cv-by-jev-api.<account>.workers.dev
